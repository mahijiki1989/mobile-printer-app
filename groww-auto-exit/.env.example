# Groww Auto-Exit example configuration.
# Copy this file to `.env` and fill the values.
# Sensitive values (API key/secret, access token) are loaded from this file ONLY
# during first run, and then moved into the OS keyring (Windows Credential Manager).
# After that, you can blank these fields. Do NOT commit your real .env.

# --- Mode ---
# live | paper | mock
GAE_MODE=paper

# --- Groww credentials ---
# You can either provide a long-lived access token directly,
# or an api_key + api_secret pair if you use the SDK helper get_access_token().
GROWW_ACCESS_TOKEN=
GROWW_API_KEY=
GROWW_API_SECRET=

# --- Risk defaults ---
GAE_DEFAULT_TARGET_INR=1000
GAE_DEFAULT_STOP_INR=-500
GAE_DAILY_MAX_LOSS_INR=-5000
GAE_MAX_OPEN_POSITIONS=10
GAE_TRADING_HOURS_START=09:15
GAE_TRADING_HOURS_END=15:25
GAE_COOLDOWN_SECONDS=30

# --- Polling / connection ---
GAE_POLL_INTERVAL_SECONDS=2
GAE_USE_WEBSOCKET=true
GAE_KILL_SWITCH_DISCONNECTS=5

# --- Exit behaviour ---
# market | limit
GAE_EXIT_ORDER_TYPE=market
# Limit slippage in % from LTP, only used when GAE_EXIT_ORDER_TYPE=limit
GAE_LIMIT_SLIPPAGE_PCT=0.10
# Require manual UI confirmation in live mode before sending exit
GAE_REQUIRE_LIVE_CONFIRM=true

# --- Storage ---
GAE_DB_PATH=%LOCALAPPDATA%\GrowwAutoExit\gae.sqlite3
GAE_LOG_DIR=%LOCALAPPDATA%\GrowwAutoExit\logs
